<UserControl x:Class="ParentalControl.Admin.Views.TelegramSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,8,16,16" MaxWidth="900" HorizontalAlignment="Left">

                <!-- ═══ Bot ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="Telegram Bot"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                                   Text="Lets you check the status and grant extra time from your phone, even when you are away. In Telegram, create a bot with @BotFather (/newbot) and paste its token here. The service only connects out to Telegram; nothing listens on this computer." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save"
                                    Command="{Binding SaveTokenCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Padding="24,8" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBox md:HintAssist.Hint="Bot token (from @BotFather)"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Opacity="0.7"
                                   Text="{Binding BotUsername, StringFormat='Bot: @{0}'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BotUsername}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </md:Card>

                <!-- ═══ Paired chats ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Command="{Binding RefreshChatsCommand}"
                                ToolTip="Refresh paired chats" Width="28" Height="28">
                            <md:PackIcon Kind="Refresh" Width="18" Height="18" />
                        </Button>
                        <TextBlock Text="Parents (paired chats)"
                                   FontSize="14" FontWeight="DemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                                   Text="The bot answers only paired chats. To pair, generate a one-time code and send it to the bot from your Telegram." />

                        <ItemsControl ItemsSource="{Binding PairedChats}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DataContext.RemoveChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                ToolTip="Unpair" Width="28" Height="28">
                                            <md:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ChatId, Mode=OneWay, StringFormat=' (chat {0})'}" Foreground="Gray" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Generate pairing code"
                                    Command="{Binding GeneratePairingCodeCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Padding="24,8" Margin="0,0,12,0" />
                            <Button Content="Send test message"
                                    Command="{Binding SendTestMessageCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Padding="24,8" />
                        </StackPanel>

                        <TextBox Text="{Binding PairingInstructions, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 FontSize="14" Margin="0,12,0,0" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Child requests ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="8,6" CornerRadius="4" Margin="0,0,0,8">
                    <TextBlock Text="Requests for More Time"
                               FontSize="14" FontWeight="DemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                                   Text="When time is running out or is up, the child can ask for more time; you get the request in Telegram with +15 / +30 / +60 / No buttons. 0 turns requests off." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="200"
                                     md:HintAssist.Hint="Requests per day"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding MaxRequestsPerDay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            <Button Content="Save"
                                    Command="{Binding SaveMaxRequestsCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Padding="24,8" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </md:Card>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
